<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="turtlebot3_waffle_pi">
  <xacro:property name="wheel_radius" value="0.033"/>
  <xacro:property name="wheel_width" value="0.018"/>
  <xacro:property name="wheel_separation" value="0.287"/>

  <material name="tb3_black"><color rgba="0.035 0.035 0.035 1"/></material>
  <material name="tb3_orange"><color rgba="1.0 0.36 0.0 1"/></material>
  <material name="sensor_gray"><color rgba="0.22 0.24 0.26 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.281 0.246 0.135"/></geometry>
      <material name="tb3_black"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.075"/>
      <geometry><box size="0.275 0.240 0.012"/></geometry>
      <material name="tb3_orange"/>
    </visual>
    <collision>
      <geometry><box size="0.281 0.246 0.135"/></geometry>
    </collision>
    <inertial>
      <mass value="1.45"/>
      <inertia ixx="0.0096" ixy="0" ixz="0" iyy="0.0118" iyz="0" izz="0.0171"/>
    </inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.100" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="drive_wheel" params="side y">
    <link name="wheel_${side}_link">
      <visual>
        <origin rpy="1.570796 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tb3_black"/>
      </visual>
      <collision>
        <origin rpy="1.570796 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.08"/>
        <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000045" iyz="0" izz="0.000025"/>
      </inertial>
    </link>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} -0.067" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left" y="0.1435"/>
  <xacro:drive_wheel side="right" y="-0.1435"/>

  <xacro:macro name="caster" params="name x">
    <link name="caster_${name}_link">
      <visual>
        <geometry><sphere radius="0.018"/></geometry>
        <material name="tb3_black"/>
      </visual>
      <collision><geometry><sphere radius="0.018"/></geometry></collision>
      <inertial>
        <mass value="0.02"/>
        <inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000003"/>
      </inertial>
    </link>
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${name}_link"/>
      <origin xyz="${x} 0 -0.082"/>
    </joint>
  </xacro:macro>

  <xacro:caster name="front" x="0.115"/>
  <xacro:caster name="rear" x="-0.115"/>

  <link name="base_scan">
    <visual>
      <geometry><cylinder radius="0.035" length="0.040"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <mass value="0.06"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00006"/>
    </inertial>
  </link>
  <joint name="base_scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.032 0 0.155"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.090 0.028"/></geometry>
      <material name="sensor_gray"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.133 0 0.115"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0.013 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <gazebo reference="wheel_left_link">
    <mu1>10.0</mu1><mu2>10.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <mu1>10.0</mu1><mu2>10.0</mu2><kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="caster_front_link">
    <mu1>0.01</mu1><mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="caster_rear_link">
    <mu1>0.01</mu1><mu2>0.01</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <gazebo reference="base_scan">
    <sensor name="lds_01" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/scan</topic>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples><resolution>1</resolution>
            <min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle>
          </horizontal>
        </scan>
        <range><min>0.12</min><max>8.0</max><resolution>0.015</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="turtlebot3_rgbd" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>8</update_rate>
      <visualize>true</visualize>
      <topic>/camera/depth</topic>
      <camera>
        <optical_frame_id>camera_depth_optical_frame</optical_frame_id>
        <horizontal_fov>1.0472</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.15</near><far>6.0</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
