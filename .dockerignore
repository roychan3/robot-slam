# Keep the build context small and reproducible. Anything listed here is never
# sent to the daemon, so it cannot end up in an image layer by accident.
#
# Docker anchors patterns at the context root and its `*` does not cross `/`,
# so a bare `build/` matches only ./build. Anything meant to apply at any depth
# needs an explicit `**/`.

.git
.gitignore
.dockerignore
Dockerfile

# Colcon output from a host-side build. Copying it in can make the in-container
# build reuse artifacts generated for a different host path.
**/build
**/devel
**/install
**/log
**/logs

# Environments and caches
.venv
env/
venv/
ENV/
.env
**/__pycache__
**/*.py[codz]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints
htmlcov/
.coverage
.coverage.*

# Packaging output
dist/
**/*.egg-info

# Large SLAM artifacts. These are the reason this file exists: a single
# recorded bag can dwarf the rest of the context.
data/
datasets/
maps/
trajectories/
outputs/
results/
**/*.bag
**/*.db3
**/rosbag2_*
**/*.pcd
**/*.ply
**/*.las
**/*.laz
**/*.pt
**/*.pth
**/*.ckpt
**/*.onnx
**/*.safetensors
**/*.log

# macOS
**/.DS_Store
