# ---- robot-slam project-specific ----

# ROS workspace output. `build/` above already matches at any depth.
devel/
install/
log/

# Agent session exports. These run to tens of megabytes and land in the repo
# root, where a `git add -A` would commit one permanently.
trajectory-*.json

# Recorded sensor data. Bags are large and rewritten often; keep them outside
# the repository or under data/.
*.bag
*.db3
rosbag2_*/
data/
datasets/

# Point clouds and meshes
*.pcd
*.ply
*.las
*.laz

# Generated maps, trajectories, and evaluation output
maps/
trajectories/
outputs/
results/

# Learned model weights
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Logs
*.log
logs/
