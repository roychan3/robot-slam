<launch>
  <arg name="scan_topic" default="/scan"/>
  <arg name="pointcloud_topic" default="/camera/depth/points"/>
  <arg name="start_octomap" default="true"/>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="1.0"/>
    <param name="maxUrange" value="7.5"/>
    <param name="maxRange" value="8.0"/>
    <param name="minimumScore" value="50"/>
    <param name="linearUpdate" value="0.10"/>
    <param name="angularUpdate" value="0.08"/>
    <param name="temporalUpdate" value="0.5"/>
    <param name="particles" value="40"/>
    <param name="xmin" value="-6.0"/>
    <param name="ymin" value="-5.0"/>
    <param name="xmax" value="6.0"/>
    <param name="ymax" value="5.0"/>
    <param name="delta" value="0.05"/>
  </node>

  <!-- The depth camera provides the raw PointCloud2 stream. OctoMap fuses
       those observations in the gmapping map frame and republishes occupied
       voxel centres as the environment's accumulated 3D point cloud. -->
  <group if="$(arg start_octomap)">
    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
      <remap from="cloud_in" to="$(arg pointcloud_topic)"/>
      <param name="frame_id" value="map"/>
      <param name="base_frame_id" value="base_footprint"/>
      <param name="resolution" value="0.08"/>
      <param name="sensor_model/max_range" value="6.0"/>
      <param name="sensor_model/hit" value="0.70"/>
      <param name="sensor_model/miss" value="0.40"/>
      <param name="filter_ground" value="false"/>
      <param name="latch" value="true"/>
    </node>
  </group>
</launch>
