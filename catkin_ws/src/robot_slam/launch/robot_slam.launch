<launch>
  <arg name="gui" default="false"/>
  <arg name="rviz" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="start_octomap" default="true"/>

  <include file="$(find robot_slam)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <include file="$(find robot_slam)/launch/slam.launch">
    <arg name="start_octomap" value="$(arg start_octomap)"/>
  </include>

  <!-- The browser UI starts RViz with the live gmapping occupancy grid and
       accumulated RGB-D point cloud. Keep it opt-in so headless runs do not
       create an additional rendering client. -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find robot_slam)/config/slam.rviz" output="screen"/>
</launch>
